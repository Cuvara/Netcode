/* Sealed session probe.
 *
 * Class names carry the cuvara- prefix, matching the convention com.cuvara.uitoolkit
 * enforces on its own exported classes: USS class names are public API, and a scene that
 * invents an unprefixed name collides with whatever a host project already calls that.
 *
 * The two hex readouts are the subject of the scene, so they are the only elements given a
 * monospace face and a background of their own — the eye has to be able to compare them
 * line against line without hunting.
 */

.cuvara-probe {
    flex-grow: 1;
    align-items: flex-start;
    justify-content: flex-start;
    background-color: rgb(14, 16, 20);
}

.cuvara-probe__panel {
    width: 520px;
    margin: 14px;
    padding: 14px 16px;
    background-color: rgba(20, 22, 27, 0.92);
    border-radius: 4px;
    border-width: 1px;
    border-color: rgb(46, 50, 58);
}

.cuvara-probe__title {
    font-size: 18px;
    -unity-font-style: bold;
    color: rgb(233, 237, 243);
    margin-bottom: 2px;
}

.cuvara-probe__subtitle {
    font-size: 11px;
    color: rgb(140, 152, 166);
    margin-bottom: 10px;
    white-space: normal;
}

.cuvara-probe__section {
    font-size: 10px;
    -unity-font-style: bold;
    letter-spacing: 1px;
    color: rgb(118, 130, 145);
    margin-top: 10px;
    margin-bottom: 4px;
}

.cuvara-probe__caption {
    font-size: 10px;
    color: rgb(118, 130, 145);
    margin-bottom: 2px;
}

/* The before/after pair. Monospace so a byte in one lines up with the same offset in the
 * other; the green one is what the game wrote, the grey one is what a capture would get. */
/* No -unity-font here on purpose. Naming a resource() font that the host project does not
 * ship renders nothing at all, silently — and this package ships no font of its own. The
 * two readouts line up because they are the same face at the same size, which is enough. */
.cuvara-probe__hex {
    font-size: 11px;
    color: rgb(176, 187, 199);
    background-color: rgb(12, 14, 18);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(38, 42, 50);
    padding: 5px 7px;
    margin-bottom: 6px;
    white-space: normal;
}

.cuvara-probe__hex--plain {
    color: rgb(92, 217, 140);
}

.cuvara-probe__row {
    flex-direction: row;
    align-items: center;
    margin-bottom: 5px;
}

.cuvara-probe__button {
    flex-grow: 1;
    height: 24px;
    margin-right: 5px;
}

.cuvara-probe__button--secondary {
    opacity: 0.75;
}

.cuvara-probe__toggle {
    margin-right: 16px;
}

.cuvara-probe__readout {
    font-size: 11px;
    color: rgb(226, 232, 240);
    white-space: normal;
    margin-bottom: 2px;
}

.cuvara-probe__readout--muted {
    color: rgb(140, 152, 166);
}

/* The verdict is the reason the scene exists, so it is the one element allowed to shout.
 * Green is the expected state: every attack pressed so far was refused. */
.cuvara-probe__verdict {
    margin-top: 12px;
    padding: 6px 8px;
    font-size: 11px;
    -unity-font-style: bold;
    color: rgb(92, 217, 140);
    background-color: rgb(21, 32, 26);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(38, 92, 62);
    white-space: normal;
}

.cuvara-probe__verdict--bad {
    color: rgb(240, 126, 116);
    background-color: rgb(38, 22, 22);
    border-color: rgb(120, 52, 48);
}

/* The log is the durable record: the readout above shows the last case, this shows every
 * case that ran, so a surprise that scrolled past is still there to read. */
.cuvara-probe__log {
    height: 140px;
    margin-top: 4px;
    padding: 4px 6px;
    background-color: rgb(18, 20, 24);
    border-radius: 3px;
    border-width: 1px;
    border-color: rgb(44, 48, 56);
}

.cuvara-probe__log Label {
    font-size: 10px;
    color: rgb(186, 192, 202);
    white-space: normal;
    margin-bottom: 2px;
}
